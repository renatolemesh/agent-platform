# Copy to .env (never commit .env). All values below are examples.
# dev | staging | prod
APP_ENV=dev

# --- LLM provider: openrouter (default for real customer data: ZDR) | openai (direct; dev/synthetic data only) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Hard cap for ALL spend through this key, enforced by the ModelGateway (also set a limit in the provider dashboard!)
LLM_TOTAL_CAP_USD=0.50
LLM_DAILY_CAP_USD=0.50

# --- Data stores (dev compose ports avoid the defaults 5432/6379) ---
DATABASE_URL=postgresql://app_rw:app_rw@127.0.0.1:55432/agentplatform
MIGRATION_DATABASE_URL=postgresql://agentplatform:agentplatform@127.0.0.1:55432/agentplatform
REDIS_URL=redis://:agentplatform@127.0.0.1:56379/0

# --- Crypto (generate with: python -m agentplatform.core.security.crypto keygen) ---
KEK_B64=
HASH_PEPPER_B64=

# --- Meta (Instagram API with Facebook Login) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# --- WhatsApp Cloud API notifier (handoff alerts to the seller) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# --- E-mail fallback ---
SMTP_URL=
ALERT_EMAIL_FROM=

# --- Console ---
CONSOLE_SESSION_SECRET=
# Connect (Chatwoot) webhook HMAC secret; empty disables /webhooks/connect
CONNECT_WEBHOOK_SECRET=
# Observability: bearer token for GET /metrics (empty disables it); OTLP/HTTP endpoint enables tracing
# The obs profile reads METRICS_TOKEN too: pass this file with --env-file (docs/runbooks/observabilidade.md).
# Tracing with the app in Compose: http://otel-collector:4318; with the app on the host: http://127.0.0.1:8143
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Perfil obs: senha inicial do admin do Grafana. Vazia, o Grafana não sobe; depois do primeiro início, mudar aqui não altera a senha
GRAFANA_ADMIN_PASSWORD=
# Platform operator alerts (budget, stuck queue, no webhooks, invalid token)
OPS_ALERT_EMAIL=
OPS_ALERT_WHATSAPP=
# Console: roles that must use TOTP 2FA (comma list; empty = optional). Prod: platform_admin,tenant_owner
CONSOLE_TOTP_REQUIRED_ROLES=
# Facebook Login app id (reconnection of the Instagram page token from the console)
META_APP_ID=
# Facebook Login for Business: ID da configuração de login (substitui a lista de permissões)
META_OAUTH_CONFIG_ID=
# Console shows AI costs in BRL: Banco Central PTAX (ptax) or always the fallback rate (fixed)
FX_SOURCE=ptax
FX_FALLBACK_USD_BRL=5.00
# Timezone for times shown in the console (the database stores UTC)
DISPLAY_TIMEZONE=America/Sao_Paulo

# Vigia externo: recebe um ping por minuto enquanto todo o ciclo funciona; o serviço avisa quando os pings param
HEARTBEAT_URL=
# Apps que enviam mensagens automáticas na conta (separados por vírgula): o eco deles não é uma pessoa assumindo
AUTOMATION_APP_IDS=
# Páginas públicas exigidas pelo App Review (/privacy, /data-deletion); sem estes dois valores elas dão 404
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
