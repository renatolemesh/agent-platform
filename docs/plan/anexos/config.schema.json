{
 "$defs": {
  "AgentConfig": {
   "additionalProperties": false,
   "properties": {
    "analyze_mode": {
     "default": "merged",
     "enum": [
      "merged",
      "parallel"
     ],
     "title": "Analyze Mode",
     "type": "string"
    },
    "max_llm_calls_per_turn": {
     "default": 4,
     "maximum": 6,
     "minimum": 2,
     "title": "Max Llm Calls Per Turn",
     "type": "integer"
    },
    "max_tool_calls_per_turn": {
     "default": 2,
     "maximum": 4,
     "minimum": 0,
     "title": "Max Tool Calls Per Turn",
     "type": "integer"
    },
    "turn_timeout_s": {
     "default": 40,
     "exclusiveMinimum": 0,
     "maximum": 90,
     "title": "Turn Timeout S",
     "type": "number"
    },
    "slow_after_s": {
     "default": 15,
     "exclusiveMinimum": 0,
     "title": "Slow After S",
     "type": "number"
    },
    "summary_every_n_turns": {
     "default": 5,
     "exclusiveMinimum": 0,
     "title": "Summary Every N Turns",
     "type": "integer"
    }
   },
   "title": "AgentConfig",
   "type": "object"
  },
  "BudgetConfig": {
   "additionalProperties": false,
   "properties": {
    "day_boundary_tz": {
     "const": "UTC",
     "default": "UTC",
     "title": "Day Boundary Tz",
     "type": "string"
    },
    "pilot_total_cap_usd": {
     "anyOf": [
      {
       "minimum": 0.0,
       "type": "number"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": "4.50",
     "title": "Pilot Total Cap Usd"
    },
    "net_credit_usd": {
     "anyOf": [
      {
       "minimum": 0.0,
       "type": "number"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": "4.74",
     "title": "Net Credit Usd"
    },
    "daily_cap_usd": {
     "anyOf": [
      {
       "minimum": 0.0,
       "type": "number"
      },
      {
       "type": "string"
      }
     ],
     "default": "2.00",
     "title": "Daily Cap Usd"
    },
    "per_conversation_cap_usd": {
     "anyOf": [
      {
       "minimum": 0.0,
       "type": "number"
      },
      {
       "type": "string"
      }
     ],
     "default": "0.10",
     "title": "Per Conversation Cap Usd"
    },
    "per_turn_cap_usd": {
     "anyOf": [
      {
       "minimum": 0.0,
       "type": "number"
      },
      {
       "type": "string"
      }
     ],
     "default": "0.02",
     "title": "Per Turn Cap Usd"
    },
    "alert_thresholds": {
     "default": [
      0.5,
      0.8,
      1.0
     ],
     "items": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "title": "Alert Thresholds",
     "type": "array"
    },
    "degradation_order": {
     "default": [
      "cheaper_model",
      "faq_only",
      "handoff_short_message"
     ],
     "items": {
      "enum": [
       "cheaper_model",
       "faq_only",
       "handoff_short_message"
      ],
      "type": "string"
     },
     "title": "Degradation Order",
     "type": "array"
    },
    "experiment_cap_usd": {
     "anyOf": [
      {
       "minimum": 0.0,
       "type": "number"
      },
      {
       "type": "string"
      }
     ],
     "default": "1.00",
     "title": "Experiment Cap Usd"
    },
    "ci_daily_cap_usd": {
     "anyOf": [
      {
       "minimum": 0.0,
       "type": "number"
      },
      {
       "type": "string"
      }
     ],
     "default": "0.50",
     "title": "Ci Daily Cap Usd"
    },
    "reservation_ttl_s": {
     "default": 120,
     "exclusiveMinimum": 0,
     "title": "Reservation Ttl S",
     "type": "integer"
    },
    "openrouter_key_limit_usd": {
     "anyOf": [
      {
       "minimum": 0.0,
       "type": "number"
      },
      {
       "type": "string"
      }
     ],
     "default": "2.50",
     "title": "Openrouter Key Limit Usd"
    }
   },
   "title": "BudgetConfig",
   "type": "object"
  },
  "Cadence": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "trigger": {
     "additionalProperties": true,
     "title": "Trigger",
     "type": "object"
    },
    "steps": {
     "items": {
      "$ref": "#/$defs/CadenceStep"
     },
     "title": "Steps",
     "type": "array"
    },
    "stop_on": {
     "items": {
      "type": "string"
     },
     "title": "Stop On",
     "type": "array"
    },
    "max_attempts": {
     "default": 1,
     "exclusiveMinimum": 0,
     "title": "Max Attempts",
     "type": "integer"
    }
   },
   "required": [
    "id",
    "trigger",
    "steps",
    "stop_on"
   ],
   "title": "Cadence",
   "type": "object"
  },
  "CadenceStep": {
   "additionalProperties": false,
   "properties": {
    "delay": {
     "title": "Delay",
     "type": "string"
    },
    "content_kind": {
     "enum": [
      "template",
      "generated"
     ],
     "title": "Content Kind",
     "type": "string"
    },
    "template_key": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Template Key"
    },
    "prompt_version": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Prompt Version"
    },
    "max_chars": {
     "default": 200,
     "exclusiveMinimum": 0,
     "title": "Max Chars",
     "type": "integer"
    }
   },
   "required": [
    "delay",
    "content_kind"
   ],
   "title": "CadenceStep",
   "type": "object"
  },
  "CommentRule": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "scope": {
     "enum": [
      "account",
      "media",
      "ad"
     ],
     "title": "Scope",
     "type": "string"
    },
    "scope_ref": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Scope Ref"
    },
    "trigger": {
     "$ref": "#/$defs/CommentTrigger"
    },
    "actions": {
     "items": {
      "enum": [
       "public_reply",
       "private_reply",
       "register_lead"
      ],
      "type": "string"
     },
     "title": "Actions",
     "type": "array"
    },
    "public_variants": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Public Variants",
     "type": "array"
    },
    "private_variants": {
     "additionalProperties": {
      "type": "string"
     },
     "default": {},
     "title": "Private Variants",
     "type": "object"
    },
    "private_weights": {
     "additionalProperties": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "default": {},
     "title": "Private Weights",
     "type": "object"
    },
    "priority": {
     "default": 100,
     "title": "Priority",
     "type": "integer"
    },
    "valid_from": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Valid From"
    },
    "valid_to": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Valid To"
    }
   },
   "required": [
    "id",
    "scope",
    "trigger",
    "actions"
   ],
   "title": "CommentRule",
   "type": "object"
  },
  "CommentTrigger": {
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "keyword",
      "regex",
      "intent"
     ],
     "title": "Kind",
     "type": "string"
    },
    "values": {
     "items": {
      "type": "string"
     },
     "title": "Values",
     "type": "array"
    }
   },
   "required": [
    "kind",
    "values"
   ],
   "title": "CommentTrigger",
   "type": "object"
  },
  "CommentsConfig": {
   "additionalProperties": false,
   "properties": {
    "enabled": {
     "default": true,
     "title": "Enabled",
     "type": "boolean"
    },
    "private_reply_dedup_window_days": {
     "default": 7,
     "maximum": 7,
     "minimum": 1,
     "title": "Private Reply Dedup Window Days",
     "type": "integer"
    },
    "sensitive_topics_to_human": {
     "default": true,
     "title": "Sensitive Topics To Human",
     "type": "boolean"
    },
    "hide_spam": {
     "default": false,
     "title": "Hide Spam",
     "type": "boolean"
    },
    "rules": {
     "default": [],
     "items": {
      "$ref": "#/$defs/CommentRule"
     },
     "title": "Rules",
     "type": "array"
    }
   },
   "title": "CommentsConfig",
   "type": "object"
  },
  "ComplianceConfig": {
   "additionalProperties": false,
   "properties": {
    "forbidden_phrases": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Forbidden Phrases",
     "type": "array"
    },
    "required_disclosures": {
     "additionalProperties": {
      "type": "string"
     },
     "default": {},
     "title": "Required Disclosures",
     "type": "object"
    },
    "never_request": {
     "default": [
      "cpf",
      "rg",
      "income",
      "assets",
      "bank_data",
      "health_data"
     ],
     "items": {
      "type": "string"
     },
     "title": "Never Request",
     "type": "array"
    },
    "opt_out_keywords": {
     "default": [
      "parar",
      "pare",
      "sair",
      "stop",
      "cancelar mensagens",
      "não quero mais"
     ],
     "items": {
      "type": "string"
     },
     "title": "Opt Out Keywords",
     "type": "array"
    },
    "judge_risk_threshold": {
     "default": 0.5,
     "maximum": 1,
     "minimum": 0,
     "title": "Judge Risk Threshold",
     "type": "number"
    },
    "product_numbers_require_provenance": {
     "const": true,
     "default": true,
     "title": "Product Numbers Require Provenance",
     "type": "boolean"
    },
    "internal_documents_never_cited": {
     "const": true,
     "default": true,
     "title": "Internal Documents Never Cited",
     "type": "boolean"
    },
    "extra_rules": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Extra Rules",
     "type": "array"
    }
   },
   "title": "ComplianceConfig",
   "type": "object"
  },
  "ConcurrencyConfig": {
   "additionalProperties": false,
   "properties": {
    "debounce_window_s": {
     "default": 4,
     "exclusiveMinimum": 0,
     "maximum": 30,
     "title": "Debounce Window S",
     "type": "number"
    },
    "debounce_max_wait_s": {
     "default": 15,
     "exclusiveMinimum": 0,
     "maximum": 60,
     "title": "Debounce Max Wait S",
     "type": "number"
    },
    "media_max_wait_s": {
     "default": 25,
     "exclusiveMinimum": 0,
     "maximum": 90,
     "title": "Media Max Wait S",
     "type": "number"
    },
    "new_message_policy": {
     "default": "cancel_if_unsent_else_next_turn",
     "enum": [
      "cancel_if_unsent_else_next_turn",
      "always_next_turn"
     ],
     "title": "New Message Policy",
     "type": "string"
    },
    "max_consecutive_restarts": {
     "default": 2,
     "maximum": 5,
     "minimum": 0,
     "title": "Max Consecutive Restarts",
     "type": "integer"
    },
    "heartbeat_timeout_s": {
     "default": 45,
     "exclusiveMinimum": 0,
     "title": "Heartbeat Timeout S",
     "type": "integer"
    },
    "max_staleness_reply_s": {
     "default": 120,
     "exclusiveMinimum": 0,
     "title": "Max Staleness Reply S",
     "type": "integer"
    },
    "max_staleness_proactive_s": {
     "default": 600,
     "exclusiveMinimum": 0,
     "title": "Max Staleness Proactive S",
     "type": "integer"
    },
    "echo_grace_s": {
     "default": 3,
     "exclusiveMinimum": 0,
     "maximum": 30,
     "title": "Echo Grace S",
     "type": "number"
    },
    "echo_reconcile_window_s": {
     "default": 120,
     "exclusiveMinimum": 0,
     "maximum": 600,
     "title": "Echo Reconcile Window S",
     "type": "number"
    },
    "ambiguous_send_policy": {
     "const": "check_conversation_api_then_fail",
     "default": "check_conversation_api_then_fail",
     "title": "Ambiguous Send Policy",
     "type": "string"
    },
    "turn_lease_s": {
     "default": 60,
     "exclusiveMinimum": 0,
     "title": "Turn Lease S",
     "type": "integer"
    }
   },
   "title": "ConcurrencyConfig",
   "type": "object"
  },
  "ConversationConfig": {
   "additionalProperties": false,
   "properties": {
    "persona": {
     "$ref": "#/$defs/PersonaConfig"
    },
    "language": {
     "const": "pt-BR",
     "default": "pt-BR",
     "title": "Language",
     "type": "string"
    },
    "max_messages_in_context": {
     "default": 8,
     "exclusiveMinimum": 0,
     "title": "Max Messages In Context",
     "type": "integer"
    },
    "max_questions_per_message": {
     "const": 1,
     "default": 1,
     "title": "Max Questions Per Message",
     "type": "integer"
    },
    "bubble_delay_ms": {
     "default": 1200,
     "maximum": 10000,
     "minimum": 0,
     "title": "Bubble Delay Ms",
     "type": "integer"
    },
    "waiting_message": {
     "default": "Só um instante, já te respondo.",
     "title": "Waiting Message",
     "type": "string"
    },
    "safe_failure_message": {
     "default": "Vou pedir para {seller} te responder por aqui.",
     "title": "Safe Failure Message",
     "type": "string"
    },
    "repetition_similarity_block": {
     "default": 0.9,
     "maximum": 1,
     "minimum": 0,
     "title": "Repetition Similarity Block",
     "type": "number"
    }
   },
   "required": [
    "persona"
   ],
   "title": "ConversationConfig",
   "type": "object"
  },
  "FollowupsConfig": {
   "additionalProperties": false,
   "properties": {
    "enabled": {
     "default": true,
     "title": "Enabled",
     "type": "boolean"
    },
    "cadences": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Cadence"
     },
     "title": "Cadences",
     "type": "array"
    }
   },
   "title": "FollowupsConfig",
   "type": "object"
  },
  "FunnelConfig": {
   "additionalProperties": false,
   "properties": {
    "stage_confidence_threshold": {
     "default": 0.7,
     "maximum": 1,
     "minimum": 0,
     "title": "Stage Confidence Threshold",
     "type": "number"
    },
    "slot_confidence_threshold": {
     "default": 0.6,
     "maximum": 1,
     "minimum": 0,
     "title": "Slot Confidence Threshold",
     "type": "number"
    },
    "max_turns_without_progress_override": {
     "additionalProperties": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "default": {},
     "title": "Max Turns Without Progress Override",
     "type": "object"
    }
   },
   "title": "FunnelConfig",
   "type": "object"
  },
  "GuidelineOverride": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "enabled": {
     "default": true,
     "title": "Enabled",
     "type": "boolean"
    },
    "priority": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Priority"
    }
   },
   "required": [
    "id"
   ],
   "title": "GuidelineOverride",
   "type": "object"
  },
  "GuidelinesConfig": {
   "additionalProperties": false,
   "properties": {
    "max_per_turn": {
     "default": 6,
     "maximum": 12,
     "minimum": 1,
     "title": "Max Per Turn",
     "type": "integer"
    },
    "overrides": {
     "default": [],
     "items": {
      "$ref": "#/$defs/GuidelineOverride"
     },
     "title": "Overrides",
     "type": "array"
    }
   },
   "title": "GuidelinesConfig",
   "type": "object"
  },
  "HandoffConfig": {
   "additionalProperties": false,
   "properties": {
    "triggers_enabled": {
     "items": {
      "type": "string"
     },
     "title": "Triggers Enabled",
     "type": "array"
    },
    "routing": {
     "items": {
      "$ref": "#/$defs/RoutingRule"
     },
     "title": "Routing",
     "type": "array"
    },
    "sla_minutes": {
     "default": 30,
     "exclusiveMinimum": 0,
     "title": "Sla Minutes",
     "type": "integer"
    },
    "expectation_message_in_hours": {
     "title": "Expectation Message In Hours",
     "type": "string"
    },
    "expectation_message_off_hours": {
     "title": "Expectation Message Off Hours",
     "type": "string"
    },
    "send_expectation_message": {
     "default": true,
     "title": "Send Expectation Message",
     "type": "boolean"
    },
    "return_to_bot_after_inactivity_min": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Return To Bot After Inactivity Min"
    },
    "off_hours_mode": {
     "default": "bot_keeps_serving",
     "enum": [
      "bot_keeps_serving",
      "await_human"
     ],
     "title": "Off Hours Mode",
     "type": "string"
    },
    "notify_off_hours": {
     "default": "at_open",
     "enum": [
      "immediately",
      "at_open"
     ],
     "title": "Notify Off Hours",
     "type": "string"
    },
    "human_unanswered_realert_min": {
     "default": 30,
     "exclusiveMinimum": 0,
     "title": "Human Unanswered Realert Min",
     "type": "integer"
    },
    "closed_reopens_on_inbound": {
     "default": true,
     "title": "Closed Reopens On Inbound",
     "type": "boolean"
    },
    "notifier": {
     "default": "whatsapp_cloud",
     "enum": [
      "whatsapp_cloud",
      "email",
      "telegram"
     ],
     "title": "Notifier",
     "type": "string"
    },
    "notifier_fallback": {
     "default": "email",
     "enum": [
      "email",
      "none"
     ],
     "title": "Notifier Fallback",
     "type": "string"
    },
    "console_links_require_login": {
     "const": true,
     "default": true,
     "title": "Console Links Require Login",
     "type": "boolean"
    }
   },
   "required": [
    "triggers_enabled",
    "routing",
    "expectation_message_in_hours",
    "expectation_message_off_hours"
   ],
   "title": "HandoffConfig",
   "type": "object"
  },
  "InputGuardConfig": {
   "additionalProperties": false,
