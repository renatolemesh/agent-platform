   "title": "MediaConfig",
   "type": "object"
  },
  "MetaConfig": {
   "additionalProperties": false,
   "properties": {
    "graph_api_version": {
     "default": "v26.0",
     "title": "Graph Api Version",
     "type": "string"
    },
    "login_kind": {
     "default": "facebook_login",
     "enum": [
      "facebook_login",
      "instagram_login"
     ],
     "title": "Login Kind",
     "type": "string"
    }
   },
   "title": "MetaConfig",
   "type": "object"
  },
