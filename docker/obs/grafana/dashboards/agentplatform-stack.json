    {
      "type": "timeseries",
      "title": "Spans recebidos e recusados",
      "description": "Por segundo. recusados acima de zero = memory_limiter atuando.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum(rate(otelcol_receiver_accepted_spans[5m])), \"kind\", \"recebidos\", \"\", \"\") or label_replace(sum(rate(otelcol_receiver_refused_spans[5m])), \"kind\", \"recusados\", \"\", \"\")",
          "legendFormat": "{{kind}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "noValue": "Nada no período, ou tracing desligado no app"
        },
        "overrides": []
