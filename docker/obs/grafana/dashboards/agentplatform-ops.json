    {
      "type": "stat",
      "title": "Kill switches",
      "description": "Plataforma. Kill switches ligados agora, em qualquer escopo. Acima de zero, algo está pausado de propósito: confira se ainda precisa estar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(agent_kill_switches_on) or on() (0 * agent_spool_bytes)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
