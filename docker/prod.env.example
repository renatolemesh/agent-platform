# Non-secret runtime settings for docker/compose.prod.yaml (copy to docker/prod.env on the server; never commit it).
# Secrets are files in docker/secrets/ (one per name in compose.prod.yaml), turned into env vars by
# scripts/docker/secrets-entrypoint.sh. Comments on their own line only (docker --env-file).
APP_ENV=prod
LLM_PROVIDER=openrouter
# Hard caps for the provider key (also set a limit in the OpenRouter dashboard)
LLM_TOTAL_CAP_USD=60
# Above the tenant's daily_cap_usd: the tenant cap degrades calmly first, this one is the last lock
LLM_DAILY_CAP_USD=2.40
META_GRAPH_VERSION=v26.0
META_APP_ID=
WHATSAPP_PHONE_NUMBER_ID=
# Seller/operator alerts on WhatsApp: cloud (official API, templates) or a text gateway: uazapi | evolution | evolution_go.
# A gateway needs its base URL; the token goes in secrets/whatsapp_alert_token. Evolution API also needs the instance name.
WHATSAPP_ALERT_PROVIDER=cloud
WHATSAPP_ALERT_URL=
WHATSAPP_ALERT_INSTANCE=
ALERT_EMAIL_FROM=
SPOOL_DIR=/var/spool/agentplatform
# Console hardening: 2FA mandatory for these roles
CONSOLE_TOTP_REQUIRED_ROLES=platform_admin,tenant_owner
# Operator alerts (budget, stuck queue, no webhooks, invalid token...)
OPS_ALERT_EMAIL=
OPS_ALERT_WHATSAPP=
# Required in production: OPS_ALERT_EMAIL or OPS_ALERT_WHATSAPP (the app refuses to start without one)
# Outside watchdog (e.g. healthchecks.io): pinged every minute; the service alerts you when the pings stop
HEARTBEAT_URL=
# Apps that send automatic messages in the account (comma-separated). Their echoes are not a person taking over.
AUTOMATION_APP_IDS=
# Public legal pages (/privacy, /data-deletion): required by the Meta App Review
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
# Tracing (optional): http://otel-collector:4318 once the obs profile is up (docs/runbooks/observabilidade.md).
# The obs profile takes no setting from this file. Its secrets are files: metrics_token (shared with the app) and
# grafana_admin_password (create it by hand before the first start; an empty one keeps Grafana from starting).
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTGRES_DB=agentplatform
POSTGRES_USER=agentplatform
# --- wal-g target (S3 compatible). Keys are secrets: walg_s3_access_key / walg_s3_secret_key / walg_libsodium_key
WALG_S3_PREFIX=s3://agentplatform-backups/prod
AWS_ENDPOINT=https://s3.example-provider.com
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
WALG_COMPRESSION_METHOD=brotli
WALG_RETAIN_FULL=14
BACKUP_HOUR_UTC=6
